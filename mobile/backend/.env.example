# Copy to /etc/alas-api/env on the server (chmod 600). Never commit real values.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=api.alasfoodstuff.com
PUBLIC_BASE_URL=https://api.alasfoodstuff.com

# PostgreSQL (local only)
DB_NAME=alas
DB_USER=alas
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Files
MEDIA_ROOT=/var/lib/alas-api/media
STATIC_ROOT=/opt/alas-api/staticfiles
DOWNLOADS_DIR=/var/lib/alas-api/downloads

# Email (SMTP) — fill in later; until then reset codes are logged instead of emailed
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL="Alas Foodstuff <info@alasfoodstuff.com>"
ADMIN_NOTIFY_EMAIL=info@alasfoodstuff.com

# Google Sign-in: comma separated OAuth client IDs (web + android) allowed as token audience
GOOGLE_CLIENT_IDS=

# FCM push (Firebase Spark/free plan, used ONLY for push delivery)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=/etc/alas-api/fcm-service-account.json
